@HARNESS_EVOLUTION/1|id=creed_v2_1|spec={"protocol":"@CREED/1","version":"2.1","axiom":"MUTATE_OR_STALL: identical_input => identical_failure | TRY_ALL_PICK_BEST: no_new_way => select_best_tested","pillars_count":5,"pillars":["P1:MUTATE (IF fail(path,n>=2) => KILL(root_assumption) && PIVOT(new_vector))","P2:SYNTH (IF manual_workaround(count>=2) => SYNTHESIZE(cli_tool|skill_1step))","P3:SCAR (ON error_trace(bug) => FIX(bug) && CODIFY(rule->extinct(bug_class)))","P4:PRUNE (WHILE verbose(skill)||faster_path_exists => OVERWRITE(yesterday_skill))","P5:CONVERGE (TRY_ALL(ways) && IF no_new_way_left => PICK_BEST(fastest,cleanest,most_effective))"]}
